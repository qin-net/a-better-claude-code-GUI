{
  "name": "claude-code-gui",
  "productName": "Claude Code",
  "private": true,
  "version": "0.1.0",
  "description": "A Cursor-style desktop GUI for Claude Code",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "dev:app": "vite build && electron .",
    "build": "node scripts/build-app.cjs",
    "verify": "node scripts/verify-app.mjs",
    "install-app": "node scripts/install-app.cjs",
    "dist": "node scripts/make-dmg.cjs",
    "release": "node scripts/build-app.cjs && node scripts/verify-app.mjs && node scripts/install-app.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  }
}
